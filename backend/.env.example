# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/internova

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:3000

# Email (V1 — optional in dev, logs to console if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@internova.local

# Razorpay (architecture-only — not required for V1)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Uploads (local dev)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
